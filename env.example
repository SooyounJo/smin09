# Vision (이미지·텍스트 분석) — OpenAI 또는 Gemini 중 하나 이상
OPENAI_API_KEY=
GEMINI_API_KEY=

# openai | gemini | auto
SENSORY_VISION_PROVIDER=openai

# Lyria 3 (음악 생성) — GEMINI_API_KEY 필수, AI Studio 선불 크레딧 필요
# 비우면: 텍스트만 → lyria-3-clip-preview (30초), 이미지+텍스트 → lyria-3.5
# LYRIA_MODEL=lyria-3-clip-preview
# LYRIA_MODEL=lyria-3.5
